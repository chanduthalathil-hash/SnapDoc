<Window x:Class="SnapDoc.Views.RecordingCountdown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#4D000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <TextBlock x:Name="CountText" Text="3" FontSize="160" FontWeight="Bold" Foreground="White"
               HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0.85"/>
        </TextBlock.Effect>
    </TextBlock>
</Window>
