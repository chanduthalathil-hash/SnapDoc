<Window x:Class="SnapDoc.Views.RecordingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapDoc Recorder"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Compact icon toggle: dims when off, accent-tinted when on. Used for the mic/system
             audio/webcam/source toggles, kept local to this window rather than added to the
             app's shared style sheet, since nothing else needs it. -->
        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#3A3A3D" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small "▾" device-picker button that sits beside a toggle (mic/webcam). -->
        <Style x:Key="ChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented source-select button (Region / Window / Full Screen). -->
        <Style x:Key="SourceSegmentStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#3A3A3D" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- Drag grip: the only part of the bar that starts a window drag, so clicks on the
                 actual controls next to it never get mistaken for a drag. -->
            <Border x:Name="DragGrip" Width="16" Cursor="SizeAll" Background="Transparent"
                    MouseLeftButtonDown="DragGrip_MouseLeftButtonDown" Margin="2,0,4,0">
                <TextBlock Text="&#8942;&#8942;" FontSize="14" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- ================= SETUP STATE ================= -->
            <StackPanel x:Name="SetupPanel" Orientation="Horizontal">
                <RadioButton x:Name="SourceRegionBtn" GroupName="Source" Style="{StaticResource SourceSegmentStyle}"
                             Content="Region" ToolTip="Drag to select an area to record" Checked="SourceRegionBtn_Checked"/>
                <RadioButton x:Name="SourceWindowBtn" GroupName="Source" Style="{StaticResource SourceSegmentStyle}"
                             Content="Window" ToolTip="Click a window to record" Checked="SourceWindowBtn_Checked"/>
                <RadioButton x:Name="SourceFullScreenBtn" GroupName="Source" Style="{StaticResource SourceSegmentStyle}"
                             Content="Full Screen" ToolTip="Record the whole monitor" IsChecked="True" Checked="SourceFullScreenBtn_Checked"/>

                <Border Width="1" Background="{StaticResource CardBorder}" Margin="8,4"/>

                <ToggleButton x:Name="MicToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#127908;"
                              ToolTip="Microphone" Click="MicToggle_Click"/>
                <Button x:Name="MicPickerBtn" Style="{StaticResource ChevronButtonStyle}" Content="&#9662;"
                        ToolTip="Choose microphone" Click="MicPickerBtn_Click"/>

                <ToggleButton x:Name="SystemAudioToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#128266;"
                              ToolTip="System audio" Margin="8,0,2,0" Click="SystemAudioToggle_Click"/>

                <ToggleButton x:Name="WebcamToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#128247;"
                              ToolTip="Webcam" Margin="8,0,2,0" Click="WebcamToggle_Click"/>
                <Button x:Name="WebcamPickerBtn" Style="{StaticResource ChevronButtonStyle}" Content="&#9662;"
                        ToolTip="Choose camera" Click="WebcamPickerBtn_Click"/>

                <Border Width="1" Background="{StaticResource CardBorder}" Margin="8,4"/>

                <Button x:Name="SettingsBtn" Style="{StaticResource RoundIconButtonStyle}" Content="&#9881;"
                        ToolTip="Recording settings" Click="SettingsBtn_Click"/>

                <Button x:Name="StartBtn" Background="{StaticResource BlueAccent}" Foreground="White"
                        BorderThickness="0" Padding="16,8" Margin="8,0,4,0" Cursor="Hand"
                        Click="StartBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Start Recording" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ================= RECORDING STATE ================= -->
            <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Border Background="#33E5484D" CornerRadius="5" Padding="8,5" Margin="2,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="{StaticResource RedAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecStateText" Text="REC" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource RedAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="PauseResumeBtn" Style="{StaticResource RoundIconButtonStyle}" Content="&#9208;"
                        ToolTip="Pause (Ctrl+Shift+P)" Click="PauseResumeBtn_Click"/>

                <ToggleButton x:Name="MicMuteToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#127908;"
                              IsChecked="True" ToolTip="Microphone (click to mute)" Click="MicMuteToggle_Click"/>
                <ToggleButton x:Name="SystemAudioMuteToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#128266;"
                              IsChecked="True" ToolTip="System audio (click to mute)" Click="SystemAudioMuteToggle_Click"/>
                <ToggleButton x:Name="WebcamRecordingToggle" Style="{StaticResource ToolbarToggleStyle}" Content="&#128247;"
                              IsChecked="True" ToolTip="Webcam (click to hide)" Click="WebcamRecordingToggle_Click"/>

                <Button x:Name="StopBtn" Background="{StaticResource RedAccent}" Foreground="White"
                        BorderThickness="0" Padding="16,8" Margin="8,0,4,0" Cursor="Hand"
                        ToolTip="Stop (Ctrl+Shift+R)" Click="StopBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="StopBtnIcon" Width="10" Height="10" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StopBtnText" Text="Stop" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="CloseBtn" Width="22" Height="22" Margin="6,0,0,0" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                    Content="&#10005;" FontSize="10" Cursor="Hand" ToolTip="Close toolbar" Click="CloseBtn_Click"/>
        </StackPanel>
    </Border>
</Window>
