<Window x:Class="SnapDoc.Views.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SnapDoc.Views.Controls"
        Title="SnapDoc Video Editor" Height="900" Width="1360"
        WindowStartupLocation="Manual"
        Icon="/Assets/icon.ico"
        Background="{StaticResource WindowBg}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolTabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: mirrors MainWindow's own sidebar (same nav rows, same "Templates" coming-soon
             row, same New Capture button) so the editor doesn't feel like a different app.
             See SidebarHome_Click etc. and RefreshStorageWidget in the code-behind. -->
        <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,20">
                    <Image Source="/Assets/icon.ico" Width="28" Height="28" Margin="0,0,8,0"/>
                    <TextBlock Text="SnapDoc" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Row="1" Click="NewCapture_Click" Margin="16,0,16,16" Padding="10,8"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        HorizontalContentAlignment="Left" Cursor="Hand">
                    <TextBlock Text="+ New Capture" FontWeight="SemiBold"/>
                </Button>

                <StackPanel Grid.Row="2" Margin="12,0">
                    <Border CornerRadius="4" Padding="10,7" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="SidebarHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#8962;" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="Home" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Padding="10,7" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="SidebarScreenshots_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128444;" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Screenshots" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#3A3A3D" CornerRadius="4" Padding="10,7" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="SidebarRecordings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9658;" FontFamily="Segoe UI Symbol" Foreground="{StaticResource BlueAccent}" Margin="0,0,8,0"/>
                            <TextBlock Text="Recordings" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="10,7" Margin="0,0,0,4" ToolTip="Coming soon" Opacity="0.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9636;" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="Templates" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Margin="16" Padding="14" Background="{StaticResource CardBg}" CornerRadius="8"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <Grid Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Left">
                            <Ellipse Width="32" Height="32" Stroke="#3A3A3D" StrokeThickness="4"/>
                            <Path x:Name="StorageRingPath" Width="32" Height="32" Stroke="{StaticResource BlueAccent}"
                                  StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="Storage" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="StorageUsageText" Text="—" FontSize="12" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StoragePercentText" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    <DockPanel Grid.Column="1">
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#8592; Back" Click="Back_Click" Style="{StaticResource FlatDarkButtonStyle}"/>
                    <TextBlock x:Name="TitleText" Text="Edit Recording" Foreground="{StaticResource TextPrimary}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="UndoBtn" Content="&#8630; Undo" Click="Undo_Click" Style="{StaticResource FlatDarkButtonStyle}" IsEnabled="False"/>
                    <Button x:Name="RedoBtn" Content="&#8631; Redo" Click="Redo_Click" Style="{StaticResource FlatDarkButtonStyle}" IsEnabled="False"/>

                    <Button x:Name="SettingsGearBtn" Content="&#9881;" Click="SettingsGear_Click" Style="{StaticResource FlatDarkButtonStyle}"
                            Padding="8,6" ToolTip="Export quality"/>
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsGearBtn}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Width="160">
                                <TextBlock Text="Export quality" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <RadioButton x:Name="QualityOriginal" Content="Original" GroupName="Quality" IsChecked="True"
                                             Foreground="{StaticResource TextPrimary}" Margin="0,2" Checked="QualityOption_Changed"/>
                                <RadioButton x:Name="QualityHigh" Content="High (smaller file)" GroupName="Quality"
                                             Foreground="{StaticResource TextPrimary}" Margin="0,2" Checked="QualityOption_Changed"/>
                                <RadioButton x:Name="QualityMedium" Content="Medium (smallest file)" GroupName="Quality"
                                             Foreground="{StaticResource TextPrimary}" Margin="0,2" Checked="QualityOption_Changed"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="OverflowBtn" Content="&#8942;" Click="Overflow_Click" Style="{StaticResource FlatDarkButtonStyle}"
                            Padding="8,6" Margin="4,0" ToolTip="More"/>
                    <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=OverflowBtn}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                            <StackPanel Width="160">
                                <Button Content="Show in folder" Click="ShowInFolder_Click" Style="{StaticResource RailStubButtonStyle}" HorizontalContentAlignment="Left"/>
                                <Button Content="Rename" Click="RenameRecording_Click" Style="{StaticResource RailStubButtonStyle}" HorizontalContentAlignment="Left"/>
                                <Button Content="Delete recording" Click="DeleteRecording_Click" Style="{StaticResource RailStubButtonStyle}"
                                        Foreground="{StaticResource RedAccent}" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="ExportBtn" Content="Export…" Click="Export_Click" Padding="16,7"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom: transport, timeline, tool tabs -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" Padding="14,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="&#9198;" Click="PrevFrame_Click" Style="{StaticResource FlatDarkButtonStyle}" Padding="8,6" ToolTip="Previous frame"/>
                    <Button x:Name="PlayPauseBtn" Content="Play" Click="PlayPause_Click"
                            Style="{StaticResource FlatDarkButtonStyle}" Width="70" Margin="2,0"/>
                    <Button Content="&#9197;" Click="NextFrame_Click" Style="{StaticResource FlatDarkButtonStyle}" Padding="8,6" ToolTip="Next frame"/>
                    <Button Content="&#9199;" Click="SkipToEnd_Click" Style="{StaticResource FlatDarkButtonStyle}" Padding="8,6" Margin="2,0" ToolTip="Skip to end"/>
                    <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Width="110"/>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Width="440" VerticalAlignment="Center"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp"/>
                    <Button Content="&#128247;" Click="Snapshot_Click" Style="{StaticResource FlatDarkButtonStyle}" Padding="8,6" Margin="12,0,2,0" ToolTip="Save current frame as a screenshot"/>
                    <ComboBox x:Name="ZoomCombo" Width="80" Margin="4,0,2,0" SelectionChanged="ZoomCombo_SelectionChanged" ToolTip="Timeline zoom">
                        <ComboBoxItem Content="Fit"/>
                        <ComboBoxItem Content="2x"/>
                        <ComboBoxItem Content="4x"/>
                    </ComboBox>
                    <Button x:Name="FullscreenBtn" Content="&#8690;" Click="Fullscreen_Click" Style="{StaticResource FlatDarkButtonStyle}" Padding="8,6" ToolTip="Fullscreen preview"/>
                </StackPanel>

                <StackPanel x:Name="TimelineAndToolsPanel">
                    <ctl:EditorTimeline x:Name="Timeline" Margin="0,0,0,10"/>

                    <ProgressBar x:Name="ExportProgress" Height="6" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton x:Name="TrimToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#9986;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Trim" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="SplitToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#10214;&#10215;" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="Split" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="DeleteToolBtn" Style="{StaticResource FlatDarkButtonStyle}" Padding="14,8" Margin="3,0" Click="DeleteTool_Click">
                            <StackPanel>
                                <TextBlock Text="&#128465;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Delete" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="AudioMixToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#127920;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Audio Mix" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="VoiceToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#127897;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Voice" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="VolumeToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#128266;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Volume" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="SpeedToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#9193;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Speed" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="FiltersToolBtn" Style="{StaticResource ToolTabButtonStyle}" Click="ToolTab_Click">
                            <StackPanel>
                                <TextBlock Text="&#127912;" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Filters" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content: preview + right panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Black">
                <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              Stretch="Uniform" MediaOpened="Preview_MediaOpened" MediaEnded="Preview_MediaEnded"/>

                <!-- Audio-only, never visible: separate mic/system sidecars played alongside Preview
                     (whose own baked audio gets muted once these exist) so the Audio Mix panel's
                     sliders/mute actually change what you hear live, not just what gets exported. -->
                <MediaElement x:Name="SystemAudioPreview" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed"/>
                <MediaElement x:Name="MicAudioPreview" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed"/>

            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="AudioMixPanel" Margin="16">
                            <TextBlock Text="Audio Mix" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <!-- Text set in code-behind (VideoEditorWindow constructor), only shown
                                 for a legacy recording with no separate tracks at all. -->
                            <TextBlock x:Name="NoSeparateAudioText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,0,0,14" Visibility="Collapsed"/>

                            <Grid>
                                <TextBlock x:Name="SystemAudioLabel" Text="System Audio" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="SystemVolumeText" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="SystemVolumeSlider" Minimum="0" Maximum="150" Value="100"
                                    ValueChanged="SystemVolumeSlider_ValueChanged"
                                    PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                            <CheckBox x:Name="SystemMuteCheck" Content="Mute" Foreground="{StaticResource TextSecondary}"
                                      Margin="0,6,0,18" Checked="AudioMixOption_Changed" Unchecked="AudioMixOption_Changed"/>

                            <!-- Hidden entirely (not just disabled) for a legacy recording with no
                                 separate tracks at all, see VideoEditorWindow's constructor. A
                                 recording that captured System but not Mic (or vice versa) still
                                 shows this row disabled-but-visible, same convention as the
                                 sidebar's "Templates" row: an honest "not available here", not
                                 hidden away. -->
                            <StackPanel x:Name="MicAudioRow">
                                <Grid>
                                    <TextBlock Text="Mic" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="MicVolumeText" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                </Grid>
                                <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="150" Value="100"
                                        ValueChanged="MicVolumeSlider_ValueChanged"
                                        PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                                <CheckBox x:Name="MicMuteCheck" Content="Mute" Foreground="{StaticResource TextSecondary}"
                                          Margin="0,6,0,18" Checked="AudioMixOption_Changed" Unchecked="AudioMixOption_Changed"/>
                            </StackPanel>

                            <CheckBox x:Name="NoiseReductionCheck" Content="Noise Reduction" Foreground="{StaticResource TextPrimary}"
                                      Margin="0,0,0,18" Checked="AudioMixOption_Changed" Unchecked="AudioMixOption_Changed"/>

                            <Button Content="Reset" Click="ResetAudioMix_Click" Style="{StaticResource FlatDarkButtonStyle}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel x:Name="VolumePanel" Margin="16" Visibility="Collapsed">
                            <TextBlock Text="Master Volume" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Grid>
                                <TextBlock Text="Output level" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="MasterVolumeText" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="150" Value="100"
                                    ValueChanged="MasterVolumeSlider_ValueChanged"
                                    PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                        </StackPanel>

                        <StackPanel x:Name="SpeedPanel" Margin="16" Visibility="Collapsed">
                            <TextBlock Text="Playback Speed" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="Speed05" Content="0.5x" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                                <RadioButton x:Name="Speed075" Content="0.75x" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                                <RadioButton x:Name="Speed1" Content="1x (normal)" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                                <RadioButton x:Name="Speed125" Content="1.25x" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                                <RadioButton x:Name="Speed15" Content="1.5x" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                                <RadioButton x:Name="Speed2" Content="2x" GroupName="Speed" Foreground="{StaticResource TextPrimary}" Margin="2" Checked="SpeedOption_Changed"/>
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel x:Name="FiltersPanel" Margin="16" Visibility="Collapsed">
                            <TextBlock Text="Filters" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Brightness" Foreground="{StaticResource TextPrimary}"/>
                            <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" Value="0"
                                    ValueChanged="FilterSlider_ValueChanged" PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                            <TextBlock Text="Contrast" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                            <Slider x:Name="ContrastSlider" Minimum="-50" Maximum="50" Value="0"
                                    ValueChanged="FilterSlider_ValueChanged" PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                            <TextBlock Text="Saturation" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                            <Slider x:Name="SaturationSlider" Minimum="-50" Maximum="50" Value="0"
                                    ValueChanged="FilterSlider_ValueChanged" PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
                            <CheckBox x:Name="GrayscaleCheck" Content="Grayscale" Foreground="{StaticResource TextPrimary}"
                                      Margin="0,18,0,0" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed"/>
                            <Button Content="Reset" Click="ResetFilters_Click" Style="{StaticResource FlatDarkButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</Window>
