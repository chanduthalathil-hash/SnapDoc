<Application x:Class="SnapDoc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SnapDoc.Converters"
             ShutdownMode="OnExplicitShutdown">
    <!-- ShutdownMode=OnExplicitShutdown: the app lives in the tray, so closing the main
         window must NOT quit the process. We exit explicitly from the tray menu. -->
    <Application.Resources>
        <ResourceDictionary>
            <conv:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
            <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
            <conv:AnnotationTypeGlyphConverter x:Key="AnnotationTypeGlyphConverter"/>

            <!-- Accent + dark-theme palette (Screenpresso-style gallery/editor look) -->
            <SolidColorBrush x:Key="AccentBrush"   Color="#2D7DD2"/>
            <SolidColorBrush x:Key="PanelBrush"    Color="#F5F7FA"/>

            <SolidColorBrush x:Key="WindowBg"      Color="#1E1E1E"/>
            <SolidColorBrush x:Key="PanelBg"       Color="#252526"/>
            <SolidColorBrush x:Key="CardBg"        Color="#2D2D30"/>
            <SolidColorBrush x:Key="CardBorder"    Color="#3F3F46"/>
            <SolidColorBrush x:Key="TextPrimary"   Color="#F1F1F1"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>

            <SolidColorBrush x:Key="RedAccent"    Color="#E5484D"/>
            <SolidColorBrush x:Key="GreenAccent"  Color="#2E7D32"/>
            <SolidColorBrush x:Key="BlueAccent"   Color="#2D7DD2"/>
            <SolidColorBrush x:Key="OrangeAccent" Color="#F9A825"/>

            <!-- Big round icon button used on the bottom bar of the gallery window.
                 Ring colour comes from BorderBrush so each instance can set its own accent. -->
            <Style x:Key="CircleIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="2" Fill="{TemplateBinding Background}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Fill" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Ring" Property="Fill" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Smaller round icon button used in the editor's left tool rail. -->
            <Style x:Key="ToolIconButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Background" Value="{StaticResource BlueAccent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Opacity="0.35"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- Flat dark button used for bottom-bar actions (Copy / Save / Publish etc). -->
            <Style x:Key="FlatDarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3A3A3D"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rectangular accent-tinted tile button used on the Workspace bottom action bar. -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="150"/>
                <Setter Property="Height" Value="78"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Editor left-rail row for a real, selectable tool. -->
            <Style x:Key="RailToolButtonStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3D"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Editor left-rail row for a tool that isn't built yet: muted text, no active state. -->
            <Style x:Key="RailStubButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
