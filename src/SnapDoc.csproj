<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Pinned explicitly so a plain `dotnet build`/`dotnet publish` (no -r win-x64) can never
         accidentally produce/prefer a 32-bit process: video export routinely needs to carry several
         large frame/audio buffers at once, which x86's ~2-4GB address space can't reliably fit even
         with plenty of physical RAM free. Confirmed the shipped build was already x64 either way
         (checked bin/Release's SnapDoc.exe PE header), but this makes it load-bearing, not incidental. -->
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- needed for global hotkeys, tray icon, screen enumeration -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SnapDoc</AssemblyName>
    <RootNamespace>SnapDoc</RootNamespace>
    <Version>0.2.22</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- WPF's SDK normally auto-generates Main() from App.xaml's ApplicationDefinition item and
         wires it as the entry point. Velopack needs to run before any of that (see Program.cs),
         so App.xaml is downgraded to a plain Page below and Program.Main takes over instead. -->
    <StartupObject>SnapDoc.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also a WPF pack resource (not just the exe's own icon) so Window.Icon (title bar/Alt+Tab)
         and TrayIcon.cs (loaded via pack URI) can both reference the same file. -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- The WindowsDesktop SDK auto-adds global usings for System.Drawing and System.Windows.Forms
         when UseWindowsForms is true. Those collide with WPF's System.Windows / System.Windows.Media
         (Point, Color, Pen, Brush, Application, MessageBox, ...) across most of this WPF-first app.
         Removed here; the handful of files that genuinely need WinForms/GDI types (TrayIcon,
         WindowsOcrEngine) import them explicitly instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM plumbing -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

    <!-- Export: Word + PowerPoint (OpenXML) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.1" />

    <!-- Export: PDF -->
    <PackageReference Include="QuestPDF" Version="2024.3.0" />

    <!-- Self-update: checks GitHub Releases and applies new versions in place -->
    <PackageReference Include="Velopack" Version="1.2.0" />

    <!-- Screen recording: H.264/MP4 encode via Media Foundation's SinkWriter (Windows' own
         built-in encoder, so there's no ffmpeg.exe to bundle and no GPL licensing to think about). -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.2" />

    <!-- Screen recording: mic + system-audio (WASAPI) capture for the recording toolbar. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Vortice.MediaFoundation pulls in System.Text.Json 9.0.1 (and its own dependency
         System.Text.Encodings.Web 9.0.1) as transitive dependencies, newer than the 8.0.x that
         .NET 8's shared framework ships. AppSettings.Load() (System.Text.Json) was compiled
         against that transitive 9.0.1, but a self-contained publish's conflict resolution still
         preferred the shared-framework-provided 8.0.x copy of these two specific assemblies over
         the restored 9.0.1 NuGet package, so the app shipped with a .deps.json demanding 9.0.1
         but only an 8.0.x DLL on disk, producing a FileNotFoundException on every launch.
         PackageConflictPreferredPackages tells the publish step's conflict resolution to let the
         NuGet-restored versions win instead of the framework-provided ones. -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.1" />

    <!-- OCR fallback (Windows.Media.Ocr is used first; Tesseract optional).
         Left commented so the project builds with zero external native deps.
         Uncomment when you wire the Tesseract backend in src/Ocr/TesseractOcrEngine.cs
    <PackageReference Include="Tesseract" Version="5.2.0" />
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Access to Windows Runtime APIs (Windows.Media.Ocr, Windows.Graphics.Capture) from a .NET app -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Enables Microsoft.VisualBasic.Interaction.InputBox, used for the quick text-annotation prompt.
         Replace with a proper WPF dialog when you polish the editor. -->
    <IncludeVisualBasicRuntime>true</IncludeVisualBasicRuntime>
  </PropertyGroup>

  <PropertyGroup>
    <PackageConflictPreferredPackages>System.Text.Json;System.Text.Encodings.Web;$(PackageConflictPreferredPackages)</PackageConflictPreferredPackages>
  </PropertyGroup>

</Project>
